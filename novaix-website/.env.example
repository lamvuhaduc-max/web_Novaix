# Postgres. Code tự chọn driver theo connection string:
#   - chứa "neon.tech"  -> driver HTTP của Neon (production)
#   - còn lại           -> driver postgres-js (Docker/Postgres local)
#
# Local (Docker, khớp với docker-compose.yml — cổng 5433 để không đụng dự án khác):
DATABASE_URL="postgresql://oalpha:oalpha@localhost:5433/oalpha"
# Neon (neon.tech > Project > Connection Details > Pooled connection):
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Chuỗi bí mật ký session. Sinh bằng: npx auth secret  (hoặc openssl rand -base64 32)
AUTH_SECRET=""

# Bắt buộc khi deploy production (Vercel tự set, chạy local thì bỏ trống)
# AUTH_URL="https://oalpha.vn"

# Lưu ảnh bài viết trên Cloudflare R2
STORAGE_DRIVER="r2"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET="oalpha"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL="https://cdn.oalpha.vn"

# Tài khoản super admin đầu tiên, dùng cho: npm run db:seed
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL="admin@oalpha.vn"
SEED_ADMIN_PASSWORD="doi-mat-khau-nay-ngay"
